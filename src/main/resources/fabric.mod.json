{
  "schemaVersion": 1,
  "id": "mialib",
  "version": "${version}",

  "name": "Mialib",
  "description": "Library for AmyMialee Mods",
  "authors": [
    "AmyMialee"
  ],
  "contact": {
    "homepage": "https://www.amymialee.dev/"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/mialib/icon.png",

  "accessWidener" : "mialib.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xyz.amymialee.mialib.Mialib"
    ]
  },
  "mixins": [
    "mialib.mixins.json"
  ],

  "depends": {
    "fabric-api": "*"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.website": "https://amymialee.dev",
        "modmenu.patreon": "https://www.patreon.com/cw/AmyMialee",
        "modmenu.discord": "https://discord.gg/aEghXGbm3J"
      }
    }
  }
}